// Where each process publishes its outputs, and per-tool extra arguments (ext.args).
process {
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy']

    withName: 'FASTP' {
        ext.args   = '--qualified_quality_phred 20 --length_required 30'
        // trimmed reads are big and easy to re-create, so only the reports are published
        publishDir = [path: { "${params.outdir}/fastp" }, mode: 'copy', pattern: '*.{json,html}']
    }
    withName: 'SALMON_INDEX' { publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy'] }
    withName: 'SALMON_QUANT' {
        ext.args   = '--seqBias --gcBias'
        publishDir = [path: { "${params.outdir}/salmon" }, mode: 'copy', pattern: '*', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MERGE_QUANT'  { publishDir = [path: { "${params.outdir}/salmon" }, mode: 'copy'] }
    withName: 'MULTIQC'      { publishDir = [path: { "${params.outdir}/multiqc" }, mode: 'copy'] }
    withName: 'FASTQC'       { publishDir = [path: { "${params.outdir}/fastqc" }, mode: 'copy', pattern: '*.{html,zip}'] }
}
