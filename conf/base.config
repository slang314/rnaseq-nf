// Default resources per process label. Edit resourceLimits to fit your machine
// (Ryzen 5 5600 = 6 cores / 12 threads).
// WSL2 is capped by %UserProfile%/.wslconfig (processors=6, memory=24GB); limits stay below that.
process {
    cpus   = 1
    memory = 2.GB
    time   = 2.h

    resourceLimits = [cpus: 6, memory: 20.GB, time: 24.h]

    // Retry once on out-of-memory / killed exit codes, with more resources
    errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single { cpus = 1;                  memory = { 2.GB  * task.attempt } }
    withLabel: process_low    { cpus = 2;                  memory = { 4.GB  * task.attempt } }
    withLabel: process_medium { cpus = { 4 * task.attempt }; memory = { 8.GB  * task.attempt } }
    withLabel: process_high   { cpus = { 8 * task.attempt }; memory = { 16.GB * task.attempt } }
}
