// Tiny synthetic dataset shipped in the repo (regenerate: scripts/simulate_test_data.py).
// Runs in a couple of minutes on a laptop.
params {
    input         = "${projectDir}/assets/test_data/samplesheet.csv"
    transcriptome = "${projectDir}/assets/test_data/transcripts.fa"
    tx2gene       = "${projectDir}/assets/test_data/tx2gene.tsv"
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
