manifest {
    name            = 'rnaseq-nf'
    author          = 'Steven Lang'
    description     = 'Small nf-core-style bulk RNA-seq pipeline: FastQC, fastp, Salmon, MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

params {
    input          = null      // samplesheet CSV: sample,fastq_1,fastq_2,condition
    transcriptome  = null      // transcript FASTA (.fa / .fa.gz)
    tx2gene        = null      // transcript<TAB>gene; optional with --gencode
    gencode        = false     // GENCODE FASTA headers (strip |fields, auto-build tx2gene)
    salmon_k       = 31
    design         = '~ condition'   // DESeq2 model; columns come from the samplesheet
    contrast       = null            // factor,numerator,denominator, e.g. condition,dex,untreated
    deseq2_alpha   = 0.05            // padj cutoff for the summary and plots
    skip_deseq2    = false
    outdir         = 'results'
    multiqc_config = "${projectDir}/assets/multiqc_config.yml"
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')  // run-report file names
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        conda.enabled     = false
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled     = true
        docker.enabled    = false
        conda.channels    = ['conda-forge', 'bioconda']
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Run reports: open timeline.html to see which step is slow on your machine
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${params.trace_report_suffix}.html" }
