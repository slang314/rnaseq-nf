nextflow_pipeline {

    name "rnaseq-nf end-to-end on synthetic data"
    script "../main.nf"
    tag "pipeline"

    test("recovers the simulated 4x up / 4x down genes") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // Mean TPM for one gene across the samples whose name starts with a prefix
            def tpm = path("$outputDir/salmon/merged_gene_tpm.tsv").readLines()*.split('\t')
            def header = tpm[0] as List
            def mean = { String gene, String prefix ->
                def row  = tpm.find { it[0] == gene } as List
                def cols = (1..<header.size()).findAll { header[it].startsWith(prefix) }
                cols.collect { row[it] as double }.sum() / cols.size()
            }

            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert path("$outputDir/salmon/merged_gene_counts.tsv").exists() },
                { assert path("$outputDir/salmon/ctrl_rep1/quant.sf").exists() },
                // Biology check: the known answer from scripts/simulate_test_data.py
                { assert mean('GENE_UP',   'trt') / mean('GENE_UP',   'ctrl') > 2.5 },
                { assert mean('GENE_DOWN', 'ctrl') / mean('GENE_DOWN', 'trt') > 2.5 },
                { assert (mean('GENE_A', 'trt') / mean('GENE_A', 'ctrl') - 1).abs() < 0.5 }
            )
        }
    }

    test("DESeq2 finds the simulated 4x changes (log2FC +2 / -2) and nothing else") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // deseq2_results.tsv: gene_id, baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
            def lines = path("$outputDir/deseq2/deseq2_results.tsv").readLines()*.split('\t')
            def col   = (lines[0] as List)
            def res   = lines.drop(1).collectEntries { r -> [r[0], [lfc: r[col.indexOf('log2FoldChange')] as double,
                                                                padj: r[col.indexOf('padj')]]] }
            def nulls = ['GENE_A', 'GENE_B', 'GENE_C', 'GENE_D', 'GENE_E', 'GENE_F']

            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/deseq2/deseq2_summary.txt").text.contains('treated vs control') },
                { assert path("$outputDir/deseq2/pca.pdf").exists() },
                { assert res['GENE_UP'].lfc   > 1.5 && res['GENE_UP'].lfc   < 2.5 },
                { assert res['GENE_DOWN'].lfc < -1.5 && res['GENE_DOWN'].lfc > -2.5 },
                { assert (res['GENE_UP'].padj as double)   < 0.01 },
                { assert (res['GENE_DOWN'].padj as double) < 0.01 },
                // unchanged genes: DESeq2's median-of-ratios normalisation should remove the
                // composition shift that TPM shows (0.82x), so they sit near log2FC 0
                { nulls.each { g -> assert res[g].lfc.abs() < 0.5 } }
            )
        }
    }

    test("one condition: DESeq2 is skipped, quantification still runs") {

        when {
            params {
                input  = "${projectDir}/assets/test_data/samplesheet_one_condition.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/salmon/merged_gene_counts.tsv").exists() },
                { assert !path("$outputDir/deseq2").exists() },
                // the task trace lists every task that ran: no DESEQ2 task at all
                { assert !workflow.trace.tasks().any { t -> t.name.contains('DESEQ2') } },
                { assert workflow.trace.tasks().any { t -> t.name.contains('SALMON_QUANT') } }
            )
        }
    }
}
